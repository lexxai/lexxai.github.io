<script>
function commentLinkUpOnclick(){
    var comments = document.querySelectorAll('.comments-person');
    for(var i = 0;i<4;i++){
        console.log(`Setting up onclick event to comment with index ${i}`);
        const place = i + 1;
        try{
           comments[i].querySelector('a').addEventListener('click', function() {
                /*if(event.target.getAttribute('href').includes(document.location.hostname) == true){*/
                    
                /*}*/
                console.log(`Clicked from ${place}`);
                if(window.screen.width > 480){
                    ym(84557758,'reachGoal',`comment_link_click_up_${place}`);
                } else {
                    ym(84557758,'reachGoal',`mob_comment_link_click_up_${place}`);
                }
               }, false);
        } catch (error) {
            console.log(`Not found a link inside comment with the index ${i + 1}`);
        }
        
    }
}
commentLinkUpOnclick();
</script>
