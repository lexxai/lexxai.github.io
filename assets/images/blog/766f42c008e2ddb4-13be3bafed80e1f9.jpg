        var topCells = Array.from(document.querySelectorAll(".traders-list_block")).slice(0, 6);
        for(var i=0;i<topCells.length;i++){
            if(window.screen.width > 480){
                setGoal(topCells[i], `home_listing_top_${i+1}`, 'click');
            } else {
