<script>
var executed = false;
function setGoal(element, goalName, type) {
    element.addEventListener(type, function(){
        
        if (!executed) {
            executed = true;
            
            var metrikaID = Ya._metrika.getCounters()[0].id;
            console.log('triggered', metrikaID, goalName);
            ym(metrikaID, 'reachGoal', goalName);
            
        }
    });
}
function setGoalsToProjectButtonsPopup(){
    var obzor_buttons = document.querySelectorAll(".top3block_popup_content_block .view_reviews_top3.btn--light-green");
    var otzyvy_buttons = document.querySelectorAll(".top3block_popup_content_block .view_comments_top3.btn--light-green");
    for (var k = 0; k < otzyvy_buttons.length; k++) {
        setGoal(obzor_buttons[k],`popup_obzor_top_${k+1}`,'click');
        setGoal(otzyvy_buttons[k],`popup_otzyvy_top_${k+1}`,'click');
    }
}
function setGoalsToGoAnywayButton(){
    var button = document.querySelector(".top3block_popup_footer a")
    setGoal(button, 'popup_go_anyway', 'click');
}
setGoalsToProjectButtonsPopup();
setGoalsToGoAnywayButton();
</script>
