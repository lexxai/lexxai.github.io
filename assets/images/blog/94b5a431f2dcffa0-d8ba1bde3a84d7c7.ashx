lateX(0);background-color:#fff}.loop-quote__author__name{font-family:"Trade Gothic Next";font-weight:700;font-size:20px;line-height:120%;margin-bottom:4px}.loop-quote__author__position{font-family:"Bull Text";font-style:normal;font-weight:400;font-size:14px;line-height:140%;color:rgba(255,255,255,.6)}</style></div></div><div class="page__panel" data-module-name="rbgemc-rb3/css-importing-panel/css-importing-panel" data-panel-uuid="ad4dd93d-92fd-40a5-b9a0-097806e3f1ac"><div><style type="text/css">.dark-theme .featured-feed-cards-rail {background: transparent;}</style></div></div><div class="page__panel" data-module-name="rbgemc-rb3/page-config/page-config-panel" data-panel-uuid="f3ff5a7c-4c15-4946-9d3e-85d617a7bee0"><div></div></div></div><header class="page__header"><div class="page__panel" data-module-name="rbgemc-rb3/navigation-panel/navigation-panel" data-panel-uuid="d20e2963-2f78-48db-b1a2-0e1a499e5846"><div><div><div class="dark-theme "><div class="header-panel"><div class="header-panel__wrapper"><div class="header-panel__global-header"><div class="pre-header unthemeable pre-header--ssr"><div class="pre-header__nudge-banner"><div class="pre-header__nudge-banner-view"><div class="nudge-banner-view" dir="ltr"></div></div></div><div class="pre-header__global-header"></div><div class="pre-header__decoration"><div class="pre-header__decoration-corner pre-header__decoration-corner--left"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><mask id="myMask7w6mzm2y2qy"><path fill="#fff" d="M0 0h20v20H0z"></path><circle fill="#000" cx="10" cy="10" r="10"></circle></mask><path mask="url(#myMask7w6mzm2y2qy)" d="M0 0h10v10H0z"></path></svg></div><div class="pre-header__decoration-corner pre-header__decoration-corner--right"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><mask id="myMaskp622vqz842"><path fill="#fff" d="M0 0h20v20H0z"></path><circle fill="#000" cx="10" cy="10" r="10"></circle></mask><path mask="url(#myMaskp622vqz842)" d="M0 0h10v10H0z"></