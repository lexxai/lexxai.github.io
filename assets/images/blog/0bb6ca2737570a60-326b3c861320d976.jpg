min-height: 390px;
overflow: hidden;
}
.kiosq-my-account-proposal-slide {
width: 100%;
position: absolute;
transition: all 0.5s;
gap: 30px;
display: flex;
}
.kiosq-my-account-proposal-slide-mobile {
width: 100%;
position: absolute;
transition: all 0.5s;
gap: 30px;
