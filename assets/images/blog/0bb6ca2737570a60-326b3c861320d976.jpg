}
.kiosq-my-account-subscription-status-flag-text {
font-weight: 700;
font-size: 14px;
line-height: 20px;
color: #ffffff;
}
.kiosq-my-account-subscription-status-title {
font-weight: 700;
font-size: 12px;
line-height: 15px;
margin-bottom: 3px;
