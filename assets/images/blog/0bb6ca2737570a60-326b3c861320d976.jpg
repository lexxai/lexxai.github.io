font-size: 14px;
font-weight: inherit;
width:80px;
}
#auth-in-nav-header .auth-in-nav-header-menu ul {
padding-left: 0px;
}
#auth-in-nav-header-sign-out svg{
fill: #fff;
}
@media (min-width: 700px) {
#auth-in-nav-header {
justify-content: flex-start !important;
}
}
@media (max-width: 699px) {
