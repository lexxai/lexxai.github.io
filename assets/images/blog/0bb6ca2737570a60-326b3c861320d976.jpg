}
.kiosq-my-account-user-infos-img {
fill: #ededed;
margin-bottom: 5px;
}
.kiosq-my-account-user-name {
font-weight: 700;
font-size: 20px;
line-height: 23px;
margin-bottom: 10px;
margin-top: 10px;
}
.kiosq-my-account-user-info-content {
