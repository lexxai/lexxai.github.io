}
.kiosq-my-account-user-info-text-img {
fill: #ededed;
}
.kiosq-my-account-user-info-text {
font-weight: 400;
font-size: 16px;
line-height: 18px;
margin-left: 10px;
}
.kiosq-my-account-title-widget {
margin-top: calc(20px + 0.5rem);
