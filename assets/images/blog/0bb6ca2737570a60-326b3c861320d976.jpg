<style>
@layer global {
.searchText {
@media (min-width: 900px) {
/* Fix tailwind v4: Added as md:[display: var(--search-text-display, inline)] cant be used with tailwind 3 */
display: var(--search-text-display, inline);
}
}
}
</style>
